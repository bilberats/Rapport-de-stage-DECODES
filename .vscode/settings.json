    "DNSKEY",
    "DNSSEC",
    "l'AFNIC",
    "l'ENPC",
    "l'ENSAE",
    "l'ENSTA",
    "latexmk",
    "makeutbmbackcover",
    "makeutbmfrontcover",
    "matplotlib",
    "numpy",
    "rndc",
    "RRSIG",
    "Tahoma",
    "tcpdump",
    "Télécom",
    "texlive",
    "texliveonfly",
    "tlmgr",
    "turbostat",
    "uftrace",
    "usepackage",
    "UTBM",
    "yocto",
    "Yoctopuce"
  ]
}